# Server Port
PORT=5001
NODE_ENV=production

# Database Connection (Option 1: Single Cloud Database URL)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Database Connection (Option 2: Individual Connection Parameters)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=navnext
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here
